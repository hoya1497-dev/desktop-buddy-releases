{
  "name": "desktop-buddy",
  "productName": "Desktop Buddy",
  "version": "0.7.0",
  "description": "화면 위를 돌아다니는 작은 캐릭터 + 집 꾸미기 + 데스크톱 코드로 친구와 함께하는 데스크톱 펫",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server/server.js",
    "dist": "electron-builder --publish never",
    "admin": "node server/admin.js",
    "release": "electron-builder --publish always"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "electron-updater": "^6.3.9"
  },
  "optionalDependencies": {
    "get-windows": "^9.0.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.desktopbuddy.app",
    "files": [
      "src/**",
      "assets/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png",
      "artifactName": "DesktopBuddy-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.games",
      "artifactName": "DesktopBuddy-${version}-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "asarUnpack": [
      "node_modules/get-windows/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "hoya1497-dev",
        "repo": "desktop-buddy-releases",
        "releaseType": "release"
      }
    ],
    "npmRebuild": false
  }
}